# ── Database ──
DATABASE_URL=postgresql://recruit_user:recruit_pass@localhost:5432/recruit_ai

# ── JWT ──
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AWS S3 / MinIO ──
S3_BUCKET_NAME=recruit-ai-uploads
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Email (Resend) ──
# Create a key at https://resend.com/api-keys. The sender domain must be
# verified in Resend or delivery is rejected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=RECRUIT.AI
SUPPORT_EMAIL=support@shouryaparashar.in

# Absolute base URL used for the logo and footer links inside emails.
# Mail clients cannot resolve relative paths.
APP_URL=https://recruitai.shouryaparashar.in
# Optional: override the logo. Defaults to APP_URL/icon.png
EMAIL_LOGO_URL=

# ── Frontend URL (for generating apply links) ──
FRONTEND_URL=http://localhost:5173

# ── AI Service URL ──
AI_SERVICE_URL=http://localhost:8001
