# ══════════════════════════════════════════════════════════════
# RECRUIT.AI — Backend environment
#
# Copy to .env and fill in. .env is gitignored and must never be
# committed. Every value below is a placeholder, not a real secret.
#
#   cp .env.example .env
#
# Unrecognised variables are ignored rather than rejected, so a stale
# entry will not stop the service booting.
# ══════════════════════════════════════════════════════════════

# ── Database (required) ──
# MongoDB. Local Docker: docker-compose up -d
# Atlas looks like: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=recruit_ai
# Kept short so an unreachable database fails fast instead of hanging for the
# driver's 30s default.
MONGODB_TIMEOUT_MS=5000

# ── JWT (required) ──
# Generate one per environment:  openssl rand -hex 32
# Changing this invalidates every issued token.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Email — Resend (optional; sends are skipped without it) ──
# Key: https://resend.com/api-keys
# The sender domain must be verified in Resend or delivery is rejected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=RECRUIT.AI
SUPPORT_EMAIL=support@yourdomain.com

# Absolute base URL for the logo and footer links inside emails.
# Mail clients cannot resolve relative paths, so this cannot be a path.
APP_URL=http://localhost:3000
# Optional override; defaults to APP_URL/icon.png
EMAIL_LOGO_URL=

# ── Frontend URL (required) ──
# Used to build the apply, task, submission, interview and password-reset
# links that go out in email. Must match where the Next.js app is served,
# or every emailed link points somewhere that does not exist.
FRONTEND_URL=http://localhost:3000

# ── Password reset ──
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ── File uploads — S3 or any S3-compatible store (optional) ──
# Without credentials the upload endpoint returns 503 and the rest of the
# app works normally. For MinIO, set S3_ENDPOINT_URL to its address.
S3_BUCKET_NAME=recruit-ai-uploads
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ── Redis (declared, not yet used by the app) ──
REDIS_URL=redis://localhost:6379/0

# ── AI service (declared, not yet called by the app) ──
AI_SERVICE_URL=http://localhost:8001
