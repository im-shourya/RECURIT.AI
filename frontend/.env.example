# ══════════════════════════════════════════════════════════════
# RECRUIT.AI — Frontend environment
#
# Copy to .env.local, which Next.js loads automatically and which is
# gitignored:
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build
# time. Never put a secret in one — it ships to every visitor.
# ══════════════════════════════════════════════════════════════

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site. Used for canonical URLs, Open Graph
# metadata, robots.txt and sitemap.xml, so it must be the real public
# origin in production or those point at the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
